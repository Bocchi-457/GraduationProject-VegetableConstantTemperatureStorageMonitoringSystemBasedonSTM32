  18:HARDWARE/DS1302/DS1302.c ****  * DS1302控制命令定义
  19:HARDWARE/DS1302/DS1302.c ****  */
  20:HARDWARE/DS1302/DS1302.c **** #define WRITE_SECOND              0x80  // 写入秒
  21:HARDWARE/DS1302/DS1302.c **** #define WRITE_MINUTE              0x82  // 写入分
  22:HARDWARE/DS1302/DS1302.c **** #define WRITE_HOUR                0x84  // 写入时
  23:HARDWARE/DS1302/DS1302.c **** #define WRITE_DAY                 0x86  // 写入日
  24:HARDWARE/DS1302/DS1302.c **** #define WRITE_MONTH               0x88  // 写入月
  25:HARDWARE/DS1302/DS1302.c **** #define WRITE_WEEK                0x8A  // 写入周
  26:HARDWARE/DS1302/DS1302.c **** #define WRITE_YEAR                0x8C  // 写入年
  27:HARDWARE/DS1302/DS1302.c **** #define WRITE_TIMER_FLAG          0xC0  // 写入定时器标志
  28:HARDWARE/DS1302/DS1302.c **** 
  29:HARDWARE/DS1302/DS1302.c **** #define READ_SECOND               0x81  // 读取秒
  30:HARDWARE/DS1302/DS1302.c **** #define READ_MINUTE               0x83  // 读取分
  31:HARDWARE/DS1302/DS1302.c **** #define READ_HOUR                 0x85  // 读取时
ARM GAS  C:\Users\31687\AppData\Local\Temp\ccPAuBDX.s 			page 2


  32:HARDWARE/DS1302/DS1302.c **** #define READ_DAY                  0x87  // 读取日
