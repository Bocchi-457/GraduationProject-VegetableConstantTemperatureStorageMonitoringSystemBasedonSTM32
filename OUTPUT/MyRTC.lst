  58:HARDWARE/rtc/MyRTC.c ****  * @note 使用LSE作为RTC时钟源
  59:HARDWARE/rtc/MyRTC.c ****  *       首次初始化时设置时间，之后从备份寄存器恢复
  60:HARDWARE/rtc/MyRTC.c ****  */
  61:HARDWARE/rtc/MyRTC.c **** void MyRTC_Init(void)
  62:HARDWARE/rtc/MyRTC.c **** {
  63:HARDWARE/rtc/MyRTC.c **** 	// 使能PWR和BKP时钟
  64:HARDWARE/rtc/MyRTC.c **** 	RCC_APB1PeriphClockCmd(RCC_APB1Periph_PWR, ENABLE);
  65:HARDWARE/rtc/MyRTC.c **** 	RCC_APB1PeriphClockCmd(RCC_APB1Periph_BKP, ENABLE);
  66:HARDWARE/rtc/MyRTC.c **** 	
  67:HARDWARE/rtc/MyRTC.c **** 	// 允许访问备份寄存器
  68:HARDWARE/rtc/MyRTC.c **** 	PWR_BackupAccessCmd(ENABLE);
  69:HARDWARE/rtc/MyRTC.c **** 	
  70:HARDWARE/rtc/MyRTC.c **** 	// 检查是否首次初始化
  71:HARDWARE/rtc/MyRTC.c **** 	if (BKP_ReadBackupRegister(BKP_DR1) != 0xA5A5)
  72:HARDWARE/rtc/MyRTC.c **** 	{
  73:HARDWARE/rtc/MyRTC.c **** 		// 复位备份寄存器
  74:HARDWARE/rtc/MyRTC.c **** 		BKP_DeInit();
  75:HARDWARE/rtc/MyRTC.c **** 	
  76:HARDWARE/rtc/MyRTC.c **** 		// 使能LSE（外部低速晶振）
  77:HARDWARE/rtc/MyRTC.c **** 		RCC_LSEConfig(RCC_LSE_ON);
  78:HARDWARE/rtc/MyRTC.c **** 		// 等待LSE稳定
  79:HARDWARE/rtc/MyRTC.c **** 		while (RCC_GetFlagStatus(RCC_FLAG_LSERDY) == RESET);
  80:HARDWARE/rtc/MyRTC.c **** 		
  81:HARDWARE/rtc/MyRTC.c **** 		// 设置RTC时钟源为LSE
  82:HARDWARE/rtc/MyRTC.c **** 		RCC_RTCCLKConfig(RCC_RTCCLKSource_LSE);
  83:HARDWARE/rtc/MyRTC.c **** 		// 使能RTC时钟
  84:HARDWARE/rtc/MyRTC.c **** 		RCC_RTCCLKCmd(ENABLE);
  85:HARDWARE/rtc/MyRTC.c **** 		
  86:HARDWARE/rtc/MyRTC.c **** 		// 等待RTC寄存器同步
  87:HARDWARE/rtc/MyRTC.c **** 		RTC_WaitForSynchro();
  88:HARDWARE/rtc/MyRTC.c **** 		// 等待上一次操作完成
  89:HARDWARE/rtc/MyRTC.c **** 		RTC_WaitForLastTask();
ARM GAS  C:\Users\31687\AppData\Local\Temp\cc3eyOtn.s 			page 3


  90:HARDWARE/rtc/MyRTC.c **** 		
  91:HARDWARE/rtc/MyRTC.c **** 		// 设置RTC预分频器（32768Hz / 32768 = 1Hz）
  92:HARDWARE/rtc/MyRTC.c **** 		RTC_SetPrescaler(32767);
  93:HARDWARE/rtc/MyRTC.c **** 		// 等待上一次操作完成
  94:HARDWARE/rtc/MyRTC.c **** 		RTC_WaitForLastTask();
  95:HARDWARE/rtc/MyRTC.c **** 		
  96:HARDWARE/rtc/MyRTC.c **** 		// 设置时间
  97:HARDWARE/rtc/MyRTC.c **** 		MyRTC_SetTime();
  98:HARDWARE/rtc/MyRTC.c **** 		
  99:HARDWARE/rtc/MyRTC.c **** 		// 写入备份寄存器，标记已初始化
 100:HARDWARE/rtc/MyRTC.c **** 		BKP_WriteBackupRegister(BKP_DR1, 0xA5A5);
 101:HARDWARE/rtc/MyRTC.c **** 	}
 102:HARDWARE/rtc/MyRTC.c **** 	else
 103:HARDWARE/rtc/MyRTC.c **** 	{
 104:HARDWARE/rtc/MyRTC.c **** 		// 等待RTC寄存器同步
 105:HARDWARE/rtc/MyRTC.c **** 		RTC_WaitForSynchro();
 106:HARDWARE/rtc/MyRTC.c **** 		// 等待上一次操作完成
 107:HARDWARE/rtc/MyRTC.c **** 		RTC_WaitForLastTask();
 108:HARDWARE/rtc/MyRTC.c **** 	}
 109:HARDWARE/rtc/MyRTC.c **** }
