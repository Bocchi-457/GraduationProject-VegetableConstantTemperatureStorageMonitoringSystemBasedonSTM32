 123:HARDWARE/STMFLASH/stmflash.c **** /**
 124:HARDWARE/STMFLASH/stmflash.c ****  * @brief 从指定地址开始写入指定长度的数据
ARM GAS  C:\Users\31687\AppData\Local\Temp\ccAWoCyQ.s 			page 10


 125:HARDWARE/STMFLASH/stmflash.c ****  * @param WriteAddr: 起始地址(此地址必须为2的倍数!!)
 126:HARDWARE/STMFLASH/stmflash.c ****  * @param pBuffer: 数据指针
 127:HARDWARE/STMFLASH/stmflash.c ****  * @param NumToWrite: 半字(16位)数(就是要写入的16位数据的个数.)
 128:HARDWARE/STMFLASH/stmflash.c ****  * @return 无
 129:HARDWARE/STMFLASH/stmflash.c ****  */
 130:HARDWARE/STMFLASH/stmflash.c **** #if STM32_FLASH_SIZE < 256
 131:HARDWARE/STMFLASH/stmflash.c **** #define STM_SECTOR_SIZE 1024 // 字节
 132:HARDWARE/STMFLASH/stmflash.c **** #else 
 133:HARDWARE/STMFLASH/stmflash.c **** #define STM_SECTOR_SIZE	2048
 134:HARDWARE/STMFLASH/stmflash.c **** #endif		 
 135:HARDWARE/STMFLASH/stmflash.c **** u16 STMFLASH_BUF[STM_SECTOR_SIZE / 2];  // 最多是2K字节
 136:HARDWARE/STMFLASH/stmflash.c **** 
 137:HARDWARE/STMFLASH/stmflash.c **** void STMFLASH_Write(u32 WriteAddr, u16 *pBuffer, u16 NumToWrite)	
 138:HARDWARE/STMFLASH/stmflash.c **** {
 139:HARDWARE/STMFLASH/stmflash.c **** 	u32 secpos;   // 扇区地址
 140:HARDWARE/STMFLASH/stmflash.c **** 	u16 secoff;   // 扇区内偏移地址(16位字计算)
 141:HARDWARE/STMFLASH/stmflash.c **** 	u16 secremain; // 扇区内剩余地址(16位字计算)	   
 142:HARDWARE/STMFLASH/stmflash.c ****   	u16 i;    
 143:HARDWARE/STMFLASH/stmflash.c **** 	u32 offaddr;   // 去掉0X08000000后的地址
 144:HARDWARE/STMFLASH/stmflash.c **** 	
 145:HARDWARE/STMFLASH/stmflash.c **** 	// 检查地址是否合法
 146:HARDWARE/STMFLASH/stmflash.c **** 	if(WriteAddr < STM32_FLASH_BASE || (WriteAddr >= (STM32_FLASH_BASE + 1024 * STM32_FLASH_SIZE)))
 147:HARDWARE/STMFLASH/stmflash.c **** 		return;  // 非法地址
 148:HARDWARE/STMFLASH/stmflash.c **** 	
 149:HARDWARE/STMFLASH/stmflash.c **** 	FLASH_Unlock();					// 解锁
 150:HARDWARE/STMFLASH/stmflash.c **** 	offaddr = WriteAddr - STM32_FLASH_BASE;  // 实际偏移地址
 151:HARDWARE/STMFLASH/stmflash.c **** 	secpos = offaddr / STM_SECTOR_SIZE;  // 扇区地址  0~127 for STM32F103RBT6
 152:HARDWARE/STMFLASH/stmflash.c **** 	secoff = (offaddr % STM_SECTOR_SIZE) / 2;  // 在扇区内的偏移(2个字节为基本单位)
 153:HARDWARE/STMFLASH/stmflash.c **** 	secremain = STM_SECTOR_SIZE / 2 - secoff;  // 扇区剩余空间大小   
 154:HARDWARE/STMFLASH/stmflash.c **** 	
 155:HARDWARE/STMFLASH/stmflash.c **** 	if(NumToWrite <= secremain) secremain = NumToWrite;  // 不大于该扇区范围
 156:HARDWARE/STMFLASH/stmflash.c **** 	
 157:HARDWARE/STMFLASH/stmflash.c **** 	while(1) 
 158:HARDWARE/STMFLASH/stmflash.c **** 	{	
 159:HARDWARE/STMFLASH/stmflash.c **** 		// 读出整个扇区的内容
 160:HARDWARE/STMFLASH/stmflash.c **** 		STMFLASH_Read(secpos * STM_SECTOR_SIZE + STM32_FLASH_BASE, STMFLASH_BUF, STM_SECTOR_SIZE / 2);
 161:HARDWARE/STMFLASH/stmflash.c **** 		
 162:HARDWARE/STMFLASH/stmflash.c **** 		// 校验数据
 163:HARDWARE/STMFLASH/stmflash.c **** 		for(i = 0; i < secremain; i++)
 164:HARDWARE/STMFLASH/stmflash.c **** 		{
 165:HARDWARE/STMFLASH/stmflash.c **** 			if(STMFLASH_BUF[secoff + i] != 0XFFFF) break;  // 需要擦除  	  
 166:HARDWARE/STMFLASH/stmflash.c **** 		}
 167:HARDWARE/STMFLASH/stmflash.c **** 		
 168:HARDWARE/STMFLASH/stmflash.c **** 		if(i < secremain)  // 需要擦除
 169:HARDWARE/STMFLASH/stmflash.c **** 		{
 170:HARDWARE/STMFLASH/stmflash.c **** 			// 擦除这个扇区
 171:HARDWARE/STMFLASH/stmflash.c **** 			FLASH_ErasePage(secpos * STM_SECTOR_SIZE + STM32_FLASH_BASE);
 172:HARDWARE/STMFLASH/stmflash.c **** 			
 173:HARDWARE/STMFLASH/stmflash.c **** 			// 复制数据
 174:HARDWARE/STMFLASH/stmflash.c **** 			for(i = 0; i < secremain; i++)
 175:HARDWARE/STMFLASH/stmflash.c **** 			{
 176:HARDWARE/STMFLASH/stmflash.c **** 				STMFLASH_BUF[i + secoff] = pBuffer[i];	  
 177:HARDWARE/STMFLASH/stmflash.c **** 			}
 178:HARDWARE/STMFLASH/stmflash.c **** 			
 179:HARDWARE/STMFLASH/stmflash.c **** 			// 写入整个扇区
 180:HARDWARE/STMFLASH/stmflash.c **** 			STMFLASH_Write_NoCheck(secpos * STM_SECTOR_SIZE + STM32_FLASH_BASE, STMFLASH_BUF, STM_SECTOR_SIZ
 181:HARDWARE/STMFLASH/stmflash.c **** 		}
ARM GAS  C:\Users\31687\AppData\Local\Temp\ccAWoCyQ.s 			page 11


 182:HARDWARE/STMFLASH/stmflash.c **** 		else
 183:HARDWARE/STMFLASH/stmflash.c **** 		{
 184:HARDWARE/STMFLASH/stmflash.c **** 			// 写已经擦除了的,直接写入扇区剩余区间
 185:HARDWARE/STMFLASH/stmflash.c **** 			STMFLASH_Write_NoCheck(WriteAddr, pBuffer, secremain);
 186:HARDWARE/STMFLASH/stmflash.c **** 		}
 187:HARDWARE/STMFLASH/stmflash.c **** 		
 188:HARDWARE/STMFLASH/stmflash.c **** 		if(NumToWrite == secremain) break;  // 写入结束了
 189:HARDWARE/STMFLASH/stmflash.c **** 		else  // 写入未结束
 190:HARDWARE/STMFLASH/stmflash.c **** 		{
 191:HARDWARE/STMFLASH/stmflash.c **** 			secpos++;  // 扇区地址增1
 192:HARDWARE/STMFLASH/stmflash.c **** 			secoff = 0;  // 偏移位置为0 	 
 193:HARDWARE/STMFLASH/stmflash.c **** 		    pBuffer += secremain;   // 指针偏移
 194:HARDWARE/STMFLASH/stmflash.c **** 			WriteAddr += secremain;  // 写地址偏移	   
 195:HARDWARE/STMFLASH/stmflash.c **** 		    NumToWrite -= secremain;  // 字节(16位)数递减
 196:HARDWARE/STMFLASH/stmflash.c **** 			
 197:HARDWARE/STMFLASH/stmflash.c **** 			if(NumToWrite > (STM_SECTOR_SIZE / 2))
 198:HARDWARE/STMFLASH/stmflash.c **** 				secremain = STM_SECTOR_SIZE / 2;  // 下一个扇区还是写不完
 199:HARDWARE/STMFLASH/stmflash.c **** 			else
 200:HARDWARE/STMFLASH/stmflash.c **** 				secremain = NumToWrite;  // 下一个扇区可以写完了
 201:HARDWARE/STMFLASH/stmflash.c **** 		} 	 
 202:HARDWARE/STMFLASH/stmflash.c **** 	};	
 203:HARDWARE/STMFLASH/stmflash.c **** 	
 204:HARDWARE/STMFLASH/stmflash.c **** 	FLASH_Lock();  // 上锁
 205:HARDWARE/STMFLASH/stmflash.c **** }
 206:HARDWARE/STMFLASH/stmflash.c **** 
